  <div class="row mt-3">
    <div class="col-8 offset-3">
        <h3>Listing Details</h3>
    </div>


    <div class="card listing-card col-6 offset-3" >
  <img src="<%=list.image.url%>" class="card-img-top show-img" alt="image failed">
  <div class="card-body">
    <p class="card-text">
    
        <i><%=`owned by ${list.owner.username}`%></i><br/>
        <b><%=list.title%></b><br/>
        <%=list.description%><br/>
        <%=list.price%><br/>
        <%=list.location%><br/>
        <%=list.country%><br/>
    </p>
  </div>
</div>


<div  class="col-8 offset-3" >
  
    <div class="booking">
      <div class="btns">
    <button id="reserveBtn" class="btn btn-danger">
     Reserve
    </button>

  <% if (curruser && list.owner._id.equals(curruser._id)) { %>
  <a href="/listings/<%=list._id%>/edit" id="edit" class="btn btn-dark col-1 offset-3">Edit</a>
    <form  method="post" action="/listings/delete/<%=list._id%>?_method=DELETE">
        <button class="btn btn-dark edit-btn offset-5 ">Delete</button>
    </form>
  <%}%>
</div>

<div id="bookingSection" style="display:none;" class="mt-3">

<form action="/booking/<%= list._id %>" method="POST">

<input type="hidden" name="listingid" value="<%= list._id %>">

<label>Check-in</label>

<input type="date" id="checkin" name="checkin" class="form-control mb-2" required>

<label>Check-out</label>

<input type="date" id="checkout" name="checkout" class="form-control mb-3" required>
<input type="hidden" name="totalPrice" id="totalPriceInput">
<p class="fw-bold">Price per night: ₹<%= list.price.toLocaleString("en-IN") %></p>

<p class="fw-bold">Total: <span id="totalPrice">₹0</span></p>
<button type="submit" class="btn btn-success">

Confirm Booking

</button>
</form>
</div>
</div>






</div>
 
</div>
  

  <div class="col-8 offset-3">
    <br/>
    <h4>Leave Your Comment</h4>
    <form method="POST" action="/reviews/<%=list._id%>/comment" class="needs-validation" novalidate>
    <!-- <div class="mb-3 mt-3">
    <label for="rating" class="form-label">Rating</label>
    <input type="range" min="1"  max="5" id="rating" name="rating"/>
    </div> -->
  <div class="mb-3 mt-3">
  <label for="rating" class="form-label">Rating</label>
  <fieldset class="starability-slot">
  <legend>First rating:</legend>
  <input type="radio" 
  id="no-rate" 
  class="input-no-rate" 
  name="rating" 
  value="1" 
  checked 
  aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
    </div>
   <div class="mb-3 mt-3">
     <label for="comment" class="form-label">Comment</label>
    <textarea 
    id="comment"
    name="comment"
    cols="30"
    rows="5"
    class="form-control"
    
    required
    ></textarea>
   
    <div  id="validationServerUsernameFeedback" class="invalid-feedback">
      Please add the comment
    </div>
   </div>

    <button class="btn btn-outline-dark">Submit</button>
    </form>
    <hr/>
    <% if(list.reviews.length>0) { %>
    <h4>All Comments</h4>
 <% } %>
    <div class="row">
     <%for(let reviews of list.reviews){%>
    <div class="card ms-3 mb-3 col-5">
    
       <div class="card-body">
           <h5 class="card-title">card title</h5>
           <p class="card-text"><%=reviews.comment%></p>
           <p class="card-text"><%=reviews.rating%></p>
             <h3>Rated element name</h3>
            <p class="starability-result" data-rating=<%=reviews.rating%>>
              Rated: 3 stars
            </p>
           <form class="mb-3" method="post" action="/reviews/<%=list._id%>/reviews/<%=reviews._id%>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
           </form>
       </div>
    </div>
    <div>
    </div>
    <%}%>
    </div>
  </div>
 
<div  class="col-8 offset-3">
  <h3>Wherer you will be</h3>
  <div id="map">

  </div>
</div>
<script src="/js/map.js"></script>


<script>

const reserveBtn = document.getElementById("reserveBtn");

const bookingSection = document.getElementById("bookingSection");

reserveBtn.addEventListener("click", function () {

bookingSection.style.display = "block";

reserveBtn.style.display = "none";

});


const checkinInput = document.getElementById("checkin");

const checkoutInput = document.getElementById("checkout");

const totalPriceEl = document.getElementById("totalPrice");

const totalPriceInput = document.getElementById("totalPriceInput");

const pricePerNight = <%= list.price %>;

function calculateTotal() {

const checkin = new Date(checkinInput.value);

const checkout = new Date(checkoutInput.value);

if (checkinInput.value && checkoutInput.value && checkout > checkin) {

const diffTime = checkout - checkin;

const nights = diffTime / (1000 * 60 * 60 * 24);

const total = nights * pricePerNight;

totalPriceEl.textContent =

"₹" + total.toLocaleString("en-IN") + " (" + nights + " nights)";
totalPriceInput.value = total;
} else {
totalPriceEl.textContent = "₹0";
totalPriceEl.textContent = "₹0";

}

}

checkinInput.addEventListener("change", calculateTotal);

checkoutInput.addEventListener("change", calculateTotal)
</script>
