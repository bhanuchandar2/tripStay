<% layout("layouts/boilerplate") %>
<br/>
<div class="row">
    <div class="col-8 offset-2">
        <h3>Create New Listing</h3>
        <br/>
        
    <form  method="POST" action="/listings/newpost" class="needs-validation" novalidate enctype="multipart/form-data" >
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
        <input 
        type="text" 
        name="listing[title]"  
        placeholder="enter the title" 
        class="form-control"
        required/>
        <div id="validationServerUsernameFeedback" class="invalid-feedback">
        Please Enter the Title
      </div>
        </div>
        <div class="mb-3">
             <label for="description" class="form-label">Description</label>
             <textarea
             name="listing[description]"  
             placeholder="enter the description" 
             class="form-control"
             required
             ></textarea>
            <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter short Description</div>
        </div>
        <!-- <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input 
            type="text" 
            name="listing[image]"  
            placeholder="enter the image url" 
            class="form-control" 
            required/>
            <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter the image URL</div>
        </div> -->
        <div class="mb-3">
            <label for="image" class="form-label">Image</label>
            <input 
            type="file" 
            name="listing[image]"  
            placeholder="enter the image url" 
            class="form-control" 
            required/>
            <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter the image URL</div>
        </div>
        <div class="row">
        <div class="mb-3 col-4">
             <label for="price" class="form-label">Price</label>
              <input type="number"  
              name="listing[price]"  
               class="form-control" 
               required
              placeholder="enter the price"/>
              <div id="validationServerUsernameFeedback" class="invalid-feedback">Price should be valid</div>
        </div>
         <div class="mb-3 col-8">
            <label for="location" class="form-label">Location</label>
            <input type="text" 
            name="listing[location]"
             class="form-control"
            placeholder="enter the location"
            required/>
            <div id="validationServerUsernameFeedback" class="invalid-feedback">Enter correct Location</div>
         </div>
         </div>
        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
        <input type="text" 
        name="listing[country]"  
        class="form-control"
        placeholder="enter the country"
        required/>
        <div id="validationServerUsernameFeedback" class="invalid-feedback">Please Enter the Country</div>
        </div>
  <div class="mb-3">
  <label for="category" class="form-label">Category</label>

  <select name="listing[category]" id="category" class="form-select" required>
    <option value="">Select Category</option>
    <option value="Apartment">Apartment</option>
    <option value="Villa">Villa</option>
    <option value="Hotel">Hotel</option>
    <option value="trending">trending</option>
    <option value="Rooms">Room</option>
  </select>
</div>
        <button class="btn btn-dark">Add</button>
    </form>
    
    </div>
    </div>
